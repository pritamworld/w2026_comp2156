pipeline {
    agent any

    environment {
        NODE_VERSION = "node-v23.11.1"
        GIT_REPO = "https://github.com/pritamworld/w2026_comp2156.git"
        GIT_BRANCH = "main"
        GH_PAGES_BRANCH = "gh-pages"
    }

    tools {
        nodejs "${NODE_VERSION}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_REPO}"
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build React App') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Deploy to GitHub Pages') {
            steps {
                bat '''
                git config user.email "jenkins@local"
                git config user.name "jenkins"

                git clone --branch ${GH_PAGES_BRANCH} ${GIT_REPO} gh-pages

                DEL /S /Q "gh-pages/*.*"

                XCOPY build/* gh-pages/ /E /I /Y

                cd gh-pages
                git add .
                git commit -m "Deploy from Jenkins"
                git push origin ${GH_PAGES_BRANCH}
                '''
            }
        }
    }
}
